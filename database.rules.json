{
  "rules": {
    "jackpotdex": {
      "$token": {
        ".read": true,
        ".write": true,
        ".validate": "$token.length >= 6 && $token.length <= 40"
      }
    },
    "jackpotcmd": {
      "$token": {
        ".read": true,
        ".write": true,
        ".validate": "$token.length >= 6 && $token.length <= 40"
      }
    },
    "jackpotcatalog": {
      ".read": true,
      ".write": true
    },
    "jackpothall": {
      ".read": true,
      ".write": true
    },

    "slotrank": {
      ".read": true,
      ".indexOn": "score",
      "$key": {
        ".write": true,
        ".validate": "$key.length >= 6 && $key.length <= 64"
      }
    },
    "slotrank_asc": {
      ".read": true,
      ".indexOn": "score",
      "$key": {
        ".write": true,
        ".validate": "$key.length >= 6 && $key.length <= 64"
      }
    },
    "slotrank_deep": {
      ".read": true,
      ".indexOn": "score",
      "$key": {
        ".write": true,
        ".validate": "$key.length >= 6 && $key.length <= 64"
      }
    }
  }
}
