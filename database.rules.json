{
  "rules": {
    "jackpotdex": {
      "$token": {
        ".read": true,
        ".write": true,
        ".validate": "$token.length >= 6 && $token.length <= 40"
      }
    },
    "jackpotcmd": {
      "$token": {
        ".read": true,
        ".write": true,
        ".validate": "$token.length >= 6 && $token.length <= 40"
      }
    },
    "jackpotcatalog": {
      ".read": true,
      ".write": true
    },
    "jackpothall": {
      ".read": true,
      ".write": true
    },

    "jackpotrank": {
      ".read": true,
      ".indexOn": ["score"],
      "$pid": {
        ".write": true,
        ".validate": "$pid.length >= 8 && $pid.length <= 40 && newData.hasChildren(['nick', 'score', 'stage', 'ts'])",
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "score": {
          ".validate": "newData.isNumber()"
        },
        "stage": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "slotrank": {
      ".read": true,
      ".indexOn": ["score"],
      "$key": {
        ".write": "$key.beginsWith('u_') ? (auth != null && $key === ('u_' + auth.uid)) : true",
        ".validate": "newData.hasChildren(['nick','score']) && newData.child('score').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 16"
      }
    },
    "slotrank_asc": {
      ".read": true,
      ".indexOn": ["score"],
      "$key": {
        ".write": "$key.beginsWith('u_') ? (auth != null && $key === ('u_' + auth.uid)) : true",
        ".validate": "newData.hasChildren(['nick','score']) && newData.child('score').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 16"
      }
    },
    "slotrank_deep": {
      ".read": true,
      ".indexOn": ["score"],
      "$key": {
        ".write": "$key.beginsWith('u_') ? (auth != null && $key === ('u_' + auth.uid)) : true",
        ".validate": "newData.hasChildren(['nick','score']) && newData.child('score').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 16"
      }
    }
  }
}
