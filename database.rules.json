{
  "rules": {
    "jackpotdex": {
      "$token": {
        ".read": true,
        ".write": true,
        ".validate": "$token.length >= 6 && $token.length <= 40"
      }
    },
    "jackpotcmd": {
      "$token": {
        ".read": true,
        ".write": true,
        ".validate": "$token.length >= 6 && $token.length <= 40"
      }
    },
    "jackpotcatalog": {
      ".read": true,
      ".write": true
    },
    "jackpothall": {
      ".read": true,
      ".write": true
    },

    "slotrank": {
      ".read": true,
      ".indexOn": ["score"],
      "$key": {
        ".write": "$key.beginsWith('u_') ? (auth != null && $key === ('u_' + auth.uid)) : true",
        ".validate": "newData.hasChildren(['nick','score']) && newData.child('score').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 16"
      }
    },
    "slotrank_asc": {
      ".read": true,
      ".indexOn": ["score"],
      "$key": {
        ".write": "$key.beginsWith('u_') ? (auth != null && $key === ('u_' + auth.uid)) : true",
        ".validate": "newData.hasChildren(['nick','score']) && newData.child('score').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 16"
      }
    },
    "slotrank_deep": {
      ".read": true,
      ".indexOn": ["score"],
      "$key": {
        ".write": "$key.beginsWith('u_') ? (auth != null && $key === ('u_' + auth.uid)) : true",
        ".validate": "newData.hasChildren(['nick','score']) && newData.child('score').isNumber() && newData.child('nick').isString() && newData.child('nick').val().length <= 16"
      }
    }
  }
}
